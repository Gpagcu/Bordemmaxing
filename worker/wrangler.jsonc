{
  "name": "bordemmaxing",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "API_ORIGIN": "https://bordemmaxing.onrender.com"
  }
}

